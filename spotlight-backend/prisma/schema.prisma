generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

model SiteSetting {
  settingKey   String  @id @map("setting_key") @db.VarChar(50)
  settingValue String  @map("setting_value") @db.LongText
  description  String? @db.VarChar(255)

  @@map("site_settings")
}

model HomeVideo {
  id          Int      @id @default(autoincrement())
  url         String   @db.VarChar(255)
  sortOrder   Int      @default(0) @map("sort_order")
  isMainVideo Boolean  @default(false) @map("is_main_video")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("home_videos")
}

model Partner {
  id        Int      @id @default(autoincrement())
  linkUrl   String?  @map("link_url") @db.VarChar(255)
  logoUrl   String   @map("logo_url") @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("partners")
}

model SocialLink {
  id        Int      @id @default(autoincrement())
  platform  String   @db.VarChar(50)
  url       String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("social_links")
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String   @db.LongText
  answer    String   @db.LongText
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("faqs")
}

model Service {
  id          Int              @id @default(autoincrement())
  name        String           @db.LongText
  slug        String           @db.LongText
  icon        String?          @db.VarChar(255)
  mainImage   String?          @map("main_image") @db.VarChar(255)
  description String?          @db.LongText
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  messages    Message[]
  projects    Project[]
  features    ServiceFeature[]
  media       ServiceMedia[]

  @@map("services")
}

model ServiceFeature {
  id        Int      @id @default(autoincrement())
  serviceId Int      @map("service_id")
  text      String   @db.LongText
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId], map: "service_features_service_id_fkey")
  @@map("service_features")
}

model ServiceMedia {
  id        Int       @id @default(autoincrement())
  serviceId Int       @map("service_id")
  url       String    @db.VarChar(255)
  mediaType MediaType @default(image) @map("media_type")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId], map: "service_media_service_id_fkey")
  @@map("service_media")
}

model Message {
  id             Int           @id @default(autoincrement())
  serviceId      Int?          @map("service_id")
  fullName       String        @map("fullname") @db.VarChar(255)
  phone          String?       @db.VarChar(50)
  email          String?       @db.VarChar(255)
  regionProvince String?       @map("region_province") @db.VarChar(100)
  preferredTime  String?       @map("preferred_time") @db.VarChar(100)
  messageText    String?       @map("message_text") @db.Text
  status         MessageStatus @default(new)
  createdAt      DateTime      @default(now()) @map("created_at")
  service        Service?      @relation(fields: [serviceId], references: [id])

  @@index([serviceId], map: "messages_service_id_fkey")
  @@map("messages")
}

model Project {
  id              Int              @id @default(autoincrement())
  serviceId       Int?             @map("service_id")
  title           String           @db.LongText
  slug            String           @db.LongText
  mainImage       String?          @map("main_image") @db.VarChar(255)
  description     String?          @db.LongText
  longDescription String?          @map("long_description") @db.LongText
  locationText    String?          @map("location_text") @db.LongText
  area            String?          @db.VarChar(100)
  buildStart      DateTime?        @map("build_start") @db.Date
  buildFinish     DateTime?        @map("build_finish") @db.Date
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  features        ProjectFeature[]
  media           ProjectMedia[]
  service         Service?         @relation(fields: [serviceId], references: [id])

  @@index([serviceId], map: "projects_service_id_fkey")
  @@map("projects")
}

model ProjectFeature {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  text      String   @db.LongText
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "project_features_project_id_fkey")
  @@map("project_features")
}

model ProjectMedia {
  id        Int       @id @default(autoincrement())
  projectId Int       @map("project_id")
  url       String    @db.VarChar(255)
  mediaType MediaType @default(image) @map("media_type")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "project_media_project_id_fkey")
  @@map("project_media")
}

model pageview {
  id        Int      @id @default(autoincrement())
  path      String   @default("/")
  date      String
createdAt DateTime @default(now()) @map("created_at")
@@map("pageview")

}

enum MediaType {
  image
  video
}

enum MessageStatus {
  new
  read
}
