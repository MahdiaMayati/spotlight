generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. Users
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

// 2. Site Settings
model SiteSetting {
  settingKey   String  @id @map("setting_key") @db.VarChar(50)
  settingValue Json    @map("setting_value")
  description  String? @db.VarChar(255)

  @@map("site_settings")
}

// 3. Home Videos
model HomeVideo {
  id          Int      @id @default(autoincrement())
  url         String   @db.VarChar(255)
  sortOrder   Int      @default(0) @map("sort_order")
  isMainVideo Boolean  @default(false) @map("is_main_video")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("home_videos")
}

// 4. Partners
model Partner {
  id        Int      @id @default(autoincrement())
  name      Json    
  linkUrl   String?  @map("link_url") @db.VarChar(255)
  logoUrl   String   @map("logo_url") @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("partners")
}

// 5. Social Links
model SocialLink {
  id        Int      @id @default(autoincrement())
  platform  String   @db.VarChar(50)
  url       String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("social_links")
}

// 6. FAQs
model Faq {
  id        Int      @id @default(autoincrement())
  question  Json
  answer    Json
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("faqs")
}


enum MediaType {
  BEFORE
  AFTER
  VIDEO
  IMAGE
}

model Project {
  id              String           @id @default(uuid())
  serviceId       String?          @map("service_id")
  title           Json
  slug            Json
  mainImage       String?          @map("main_image") @db.VarChar(255)
  description     Json?
  longDescription Json?            @map("long_description")
  locationText    Json?            @map("location_text")
  area            String?          @db.VarChar(100)
  buildStart      DateTime?        @map("build_start") @db.Date
  buildFinish     DateTime?        @map("build_finish") @db.Date
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  service         Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  features        ProjectFeature[]
  media           ProjectMedia[]

  @@map("projects")
}

model ProjectMedia {
  id        Int       @id @default(autoincrement())
  projectId String    @map("project_id")
  url       String    @db.VarChar(255)
  type      MediaType @default(IMAGE)
  createdAt DateTime  @default(now()) @map("created_at")

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_media")
}

model ProjectFeature {
  id        Int      @id @default(autoincrement())
  projectId String   @map("project_id")
  text      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_features")
}


model Service {
  id               String           @id @default(uuid())
  name             Json
  slug             Json
  icon             String?          @db.VarChar(255)
  mainImage        String?          @map("main_image") @db.VarChar(255)
  shortDescription Json?            @map("short_description")
  description      Json?
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  features         ServiceFeature[]
  media            ServiceMedia[]
  messages         Message[]
  projects         Project[]

  @@map("services")
}

model ServiceMedia {
  id        Int       @id @default(autoincrement())
  serviceId String    @map("service_id")
  url       String    @db.VarChar(255)
  type      MediaType @default(IMAGE)
  createdAt DateTime  @default(now()) @map("created_at")

  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_media")
}


model ServiceFeature {
  id        Int      @id @default(autoincrement())
  serviceId String   @map("service_id")
  text      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_features")
}


// 10. Messages / Inquiries
enum MessageStatus {
  new
  read
}

model Message {
  id             Int           @id @default(autoincrement())
  serviceId      String?       @map("service_id") 
  fullName       String        @map("fullname") @db.VarChar(255)
  phone          String?       @db.VarChar(50)
  email          String?       @db.VarChar(255)
  regionProvince String?       @map("region_province") @db.VarChar(100)
  preferredTime  String?       @map("preferred_time") @db.VarChar(100)
  messageText    String?       @map("message_text") @db.Text
  status         MessageStatus @default(new)
  createdAt      DateTime      @default(now()) @map("created_at")

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@map("messages")
}

// 14. Team Members
model TeamMember {
  id        Int      @id @default(autoincrement())
  name      Json     
  role      Json
  image     String?  @db.VarChar(255)
 sortOrder    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("team_members")
}

// 15. Analytics / Visitors
model Visitor {
  id         String         @id @default(uuid())
  cookieId   String         @unique @map("cookie_id")
  createdAt  DateTime       @default(now()) @map("created_at")
  lastActive DateTime       @updatedAt @map("last_active")
  visits     AnalyticsLog[]

  @@map("visitors")
}

model AnalyticsLog {
  id        Int      @id @default(autoincrement())
  visitorId String   @map("visitor_id")
  pageUrl   String   @map("page_url")
  action    String?
  entityId  String?  @map("entity_id") 
  createdAt DateTime @default(now()) @map("created_at")

  visitor Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@map("analytics_logs")
}